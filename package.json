{
  "name": "desktop-buddies",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @buddies/maker dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:browser": "pnpm build && node apps/maker/tests/browser/run.mjs",
    "test:manager": "pnpm --filter @buddies/desktop build && node apps/desktop/tests/browser/run.mjs && node apps/desktop/tests/browser/probe-overlay.mjs",
    "test:maker-view": "node packages/maker-view/tests/browser/run.mjs",
    "typecheck": "pnpm -r typecheck",
    "validate-buddy": "node packages/validate-buddy/bin/validate-buddy.mjs"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
